{
  "name": "disk-mac-desktop",
  "productName": "Disk Mac",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Disk Mac desktop app, powered by the mac-cleaner-cli scanners and maintenance routines",
  "author": "guhcostan",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs --dev && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:uninstall-asar": "node scripts/test-uninstall-asar.mjs",
    "test:disk-analysis": "node scripts/test-disk-analysis.mjs",
    "test:backups": "node scripts/test-backups.mjs",
    "test:process-control": "node scripts/test-process-control.mjs",
    "icons": "python3 scripts/make-icons.py",
    "dist": "node scripts/build.mjs && electron-builder --mac --config electron-builder.config.cjs --publish never",
    "screenshots": "node scripts/screenshots/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "1.56.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
